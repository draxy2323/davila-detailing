# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real keys.

# REQUIRED for the quote form to deliver requests. Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Where quote requests are emailed. Defaults to daviladetailing@yahoo.com.
# QUOTE_TO_EMAIL=daviladetailing@yahoo.com

# Sender address. The default (onboarding@resend.dev) only delivers to the email
# address your Resend account is registered with. After verifying your own
# domain in Resend, use an address on it, e.g. "Davila Detailing <quotes@yourdomain.com>".
# QUOTE_FROM_EMAIL=

# Public site URL, used for canonical links, sitemap, Open Graph and structured
# data (not shown as contact info). Optional on Vercel until you have a domain.
# NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
